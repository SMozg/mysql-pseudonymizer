# Скопировать в .env и заполнить значения. Сам .env в репозиторий не попадает (см. .gitignore).
# Ни одно из значений ниже не появляется в коде, в конфиге, в тестах, в журнале прогона,
# в отчёте приёмки и в выводе CLI.
#
# ⛔ Пустая строка = переменная не задана: файл-шаблон никого не заслоняет.
# ⛔ Переменная, заданная снаружи (export, CI, systemd), сильнее этого файла.
# Пароли демо-стенда живут в demo/sakila/.env — их читает и docker compose, и санитайзер;
# дублировать их здесь не нужно. Этот файл — про свою базу и про ключи инструмента.

# доступ к СВОЕЙ базе MySQL (для демо-стенда — demo/sakila/.env)
MYSQL_HOST_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
# альтернатива MYSQL_PASSWORD, если используется root-доступ
MYSQL_ROOT_PASSWORD=

# ключ шифрования словаря замен (соответствие "исходное значение -> замена")
# ⛔ ШЕСТНАДЦАТЕРИЧНАЯ строка: python -c "import secrets; print(secrets.token_hex(32))"
SANIT_KEY=

# ключ доступа к модели, которая подбирает замены
# ⛔ Нужен для классов КЗ-1…КЗ-3 (имя, фамилия, город): без него прогон встанет.
SANIT_MODEL_KEY=

# адрес OpenAI-совместимого шлюза; пусто -- провайдер по умолчанию
SANIT_MODEL_BASE_URL=
