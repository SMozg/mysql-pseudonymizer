# Скопировать в .env и заполнить значения. Сам .env в репозиторий не попадает (см. .gitignore).
# Ни одно из значений ниже не появляется в коде, в конфиге, в тестах, в журнале прогона,
# в отчёте приёмки и в выводе CLI.

# доступ к стенду MySQL
MYSQL_USER=
MYSQL_PASSWORD=
# альтернатива MYSQL_PASSWORD, если используется root-доступ
MYSQL_ROOT_PASSWORD=

# ключ шифрования словаря замен (соответствие "исходное значение -> замена")
SANIT_KEY=

# ключ доступа к модели, которая подбирает замены
SANIT_MODEL_KEY=

# адрес OpenAI-совместимого шлюза; пусто -- провайдер по умолчанию
SANIT_MODEL_BASE_URL=
