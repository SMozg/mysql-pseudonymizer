# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.pytest_cache/

# секреты и локальные настройки
.env
*.env

# словарь замен — деанонимизатор: он хранит соответствие "исходное значение → замена"
# и восстанавливает персональные данные. В репозиторий не попадает никогда — ни сам файл,
# ни каталог, в котором прогон его держит.
*.enc
dictionary/
runs/

# журнал прогона — фиксирует ход санитизации конкретной базы, к коду не относится
*.runlog
runlog/

# ⛔ report/ НЕ закрыт: отчёт приёмки — предъявляемое доказательство, по нему
# сверяется каждое число, которое инструмент о себе заявляет. Закрытым он делал
# заявления непроверяемыми. Персональных данных в нём нет по построению: критерий 23
# меряет именно это («в журнале прогона и в отчёте приёмки нет ПД, паролей, ключей
# и записей словаря») и стоит зелёным.
# Закрытыми остаются деанонимизатор (runs/, *.enc) и журнал прогона (runlog/) —
# они привязывают замену к исходному значению.
*.pdf

# junit-отчёт прогона тестов (его читает сторож CI, .github/ci_gate.py)
junit.xml

# IDE / OS
.DS_Store
.idea/
.vscode/

# ⛔ проектные документы: в публичный репозиторий НЕ едут.
# Причина не вкусовая: они содержат полные пути рабочей папки и внутренние ссылки
# на решения владельца. Контракт и покрытие — рабочие бумаги, а не документация кода;
# читателю репозитория адресован README.
/КОНТРАКТ.md
/КОНТРАКТ-ФОРМЫ.md
/ПОКРЫТИЕ.md
/КРАСНАЯ-ФАЗА.md
/КРАСНАЯ-ФАЗА-К1.md
# ⛔ Правило по ШАБЛОНУ, а не поимённо: файл К1 появился позже правила и едва не уехал
# в публичный репозиторий. Поимённый список стареет молча — шаблон не стареет.
/КРАСНАЯ-ФАЗА*.md
